// Baseline topology re-optimised for maximum gain-bandwidth product (fair comparison), PTM 90 nm BSIM4
// Run:  spectre baseline_reopt_gbw.scs      (results in baseline_reopt_gbw.raw, open with ViVA)
// Generated by scripts/emit.py
simulator lang=spectre
global 0
include "ptm90.lib"   // SPICE-syntax PTM card; Spectre reads non-.scs includes as SPICE
parameters vdd=1.0 cpd=50f cout=30f lf=1.251n vg3b=0.596 vg2b=0.591 rsl=42.8

Vg2b (g2b 0) vsource dc=vg2b type=dc
Vdd (vdd 0) vsource dc=vdd type=dc
Vg3b (g3b 0) vsource dc=vg3b type=dc
M2b (n g2b vdd vdd) pmos90 w=5.35u l=90n as=1.07p ad=1.07p ps=11.1u pd=11.1u
M1 (n vdd in 0) nmos90 w=1.8u l=90n as=0.36p ad=0.36p ps=4u pd=4u
M2 (in n 0 0) nmos90 w=12.37u l=90n as=2.474p ad=2.474p ps=25.14u pd=25.14u
M3 (out n 0 0) nmos90 w=1.69u l=90n as=0.338p ad=0.338p ps=3.78u pd=3.78u
M3b (out g3b vdd vdd) pmos90 w=4.34u l=90n as=0.868p ad=0.868p ps=9.08u pd=9.08u
Lf (out xl) inductor l=lf
Rsl (xl in) resistor r=rsl
Cpd (in 0) capacitor c=cpd
Cout (out 0) capacitor c=cout
Iin (0 in) isource dc=0 type=dc mag=1

simOpts options temp=35 tnom=27 reltol=1e-4 vabstol=1e-6 iabstol=1e-12 save=allpub
dcOp dc oppoint=logfile
dcOpInfo info what=oppoint where=rawfile
acZt ac start=10M stop=200G dec=40
noiseIn (out 0) noise start=10M stop=200G dec=40 iprobe=Iin
