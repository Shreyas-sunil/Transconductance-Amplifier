* Baseline topology re-optimised for maximum gain-bandwidth product (fair comparison), PTM 90 nm BSIM4
* LTspice: File > Open (All files) > this .net, then Run.
* One analysis at a time: keep one of the lines below active, comment the others with ";".
.include ptm90.lib
.param vdd=1.0 cpd=50f cout=30f lf=1.251n vg3b=0.596 vg2b=0.591 rsl=42.8
.temp 35

Vg2b g2b 0 dc {vg2b}
Vdd vdd 0 dc {vdd}
Vg3b g3b 0 dc {vg3b}
M2b n g2b vdd vdd pmos90 W=5.35u L=90n AD=1.07p AS=1.07p PD=11.1u PS=11.1u
M1 n vdd in 0 nmos90 W=1.8u L=90n AD=0.36p AS=0.36p PD=4u PS=4u
M2 in n 0 0 nmos90 W=12.37u L=90n AD=2.474p AS=2.474p PD=25.14u PS=25.14u
M3 out n 0 0 nmos90 W=1.69u L=90n AD=0.338p AS=0.338p PD=3.78u PS=3.78u
M3b out g3b vdd vdd pmos90 W=4.34u L=90n AD=0.868p AS=0.868p PD=9.08u PS=9.08u
Lf out xl {lf}
Rsl xl in {rsl}
Cpd in 0 {cpd}
Cout out 0 {cout}
Iin 0 in dc 0 ac 1

.ac dec 40 10Meg 200G
;.noise V(out) Iin dec 40 10Meg 200G
;.op
.meas AC zt0 FIND mag(V(out)) AT 100Meg
.meas AC zpk MAX mag(V(out))
.meas AC f3db WHEN mag(V(out))=zt0/sqrt(2) FALL=1
.backanno
.end
