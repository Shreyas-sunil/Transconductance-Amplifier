* Baseline topology re-optimised for maximum gain-bandwidth product (fair comparison), PTM 90 nm BSIM4
* Run:  ngspice -b baseline_reopt_gbw.cir
* Generated by scripts/emit.py - edit scripts/circuits.py to change the design.
.include ../../models/ptm90.lib
.param vdd=1.0 cpd=50f cout=30f lf=1.251n vg3b=0.596 vg2b=0.591 rsl=42.8
.temp 35

Vg2b g2b 0 dc {vg2b}
Vdd vdd 0 dc {vdd}
Vg3b g3b 0 dc {vg3b}
M2b n g2b vdd vdd pmos90 W=5.35u L=90n AD=1.07p AS=1.07p PD=11.1u PS=11.1u
M1 n vdd in 0 nmos90 W=1.8u L=90n AD=0.36p AS=0.36p PD=4u PS=4u
M2 in n 0 0 nmos90 W=12.37u L=90n AD=2.474p AS=2.474p PD=25.14u PS=25.14u
M3 out n 0 0 nmos90 W=1.69u L=90n AD=0.338p AS=0.338p PD=3.78u PS=3.78u
M3b out g3b vdd vdd pmos90 W=4.34u L=90n AD=0.868p AS=0.868p PD=9.08u PS=9.08u
Lf out xl {lf}
Rsl xl in {rsl}
Cpd in 0 {cpd}
Cout out 0 {cout}
Iin 0 in dc 0 ac 1

.control
set noaskquit
op
print v(in) v(out) v(n) i(vdd)
print @m2b[id] @m1[id] @m2[id] @m3[id] @m3b[id]
print @m2b[gm] @m1[gm] @m2[gm] @m3[gm] @m3b[gm]
ac dec 40 10meg 200g
let zt_db = vdb(out)
meas ac zt_100MHz find zt_db at=100meg
meas ac zt_peak max zt_db
let zt_m3 = zt_100MHz - 3
meas ac f_3dB when zt_db=zt_m3 fall=1
set wr_singlescale
wrdata baseline_reopt_gbw_ac.txt vdb(out) vp(out)
noise v(out) iin dec 40 10meg 200g
setplot noise1
wrdata baseline_reopt_gbw_noise.txt inoise_spectrum
.endc
.end
