* Current-mirror TIA with NMOS source-follower active inductor - reconstruction
* Run: ngspice -b ref_shaaban_AN.cir   (PTM 90 nm BSIM4, VDD = 1 V)
.include ptm90.lib
.temp 35

Vdd vdd 0 dc 1
Cpd in 0 450f
CL out 0 50f
Iin 0 in dc 0 ac 1
Ibp vbp 0 dc 20u
Mdp vbp vbp vdd vdd pmos90 W=2u L=200n AD=0.4p AS=0.4p PD=4.4u PS=4.4u
Cbp vbp vdd 2p
Mp1 in vbp vdd vdd pmos90 W=37.58u L=200n AD=7.516p AS=7.516p PD=75.56u PS=75.56u
M1 in in 0 0 nmos90 W=7.45u L=100n AD=1.49p AS=1.49p PD=15.3u PS=15.3u
M2 out in 0 0 nmos90 W=23.22u L=100n AD=4.643p AS=4.643p PD=46.83u PS=46.83u
Rf out in 8.4054k
Ma vdd ga out 0 nmos90 W=2.032u L=100n AD=0.4064p AS=0.4064p PD=4.464u PS=4.464u
Rg vdd ga 53.21k

.control
set noaskquit
op
print i(vdd) v(in) v(out)
ac dec 40 1Meg 100G
let zt = vdb(out)
meas ac zt0 find zt at=10meg
meas ac zpk max zt
let zm3 = zt0 - 3
meas ac f3db when zt=zm3 fall=1
wrdata ref_shaaban_AN_ac.txt vdb(out) vp(out)
noise v(out) iin dec 40 1Meg 100G
setplot noise1
wrdata ref_shaaban_AN_noise.txt inoise_spectrum
.endc
.end
