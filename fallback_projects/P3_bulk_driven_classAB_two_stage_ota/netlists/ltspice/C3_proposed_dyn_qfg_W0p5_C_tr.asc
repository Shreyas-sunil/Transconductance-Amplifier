TEXT 0 1664 Left 2 ;C3_proposed_dyn_qfg_W0p5, testbench C_tr
TEXT 0 1704 Left 2 ;Nets are joined by their labels (same name = same net). Open in LTspice and press Run.
TEXT 0 1744 Left 2 ;Unity-gain follower, 0.1 -> 0.5 V step, CL = 150 pF. Slew = 20-80 % slope of V(out).
TEXT 0 1784 Left 2 !.include ptm90.lib
TEXT 0 1824 Left 2 !.tran 0 82u 0 20n
TEXT 0 1864 Left 2 !.meas TRAN t_r20 WHEN V(out)=0.18 RISE=1
TEXT 0 1904 Left 2 !.meas TRAN t_r80 WHEN V(out)=0.42 RISE=1
TEXT 0 1944 Left 2 !.meas TRAN sr_rise_V_per_us PARAM 0.24/(t_r80-t_r20)/1e6
TEXT 0 1984 Left 2 !.meas TRAN t_f80 WHEN V(out)=0.42 FALL=1
TEXT 0 2024 Left 2 !.meas TRAN t_f20 WHEN V(out)=0.18 FALL=1
TEXT 0 2064 Left 2 !.meas TRAN sr_fall_V_per_us PARAM -0.24/(t_f20-t_f80)/1e6
